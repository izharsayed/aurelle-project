# Velora Fine Jewelry — Environment Configuration
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control.

# -------------------------------------------------------------
# 1. Cashfree Payment Gateway
# -------------------------------------------------------------
# Get these credentials from https://merchant.cashfree.com/merchants/login
# Sandbox: Use test credentials generated from the Cashfree Merchant Sandbox dashboard.
# Production: Use live credentials generated from the Cashfree Merchant Production dashboard.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# Set to 'sandbox' for testing, or 'production' for live payments
CASHFREE_ENVIRONMENT=sandbox
# Cashfree API Version (default 2023-08-01)
CASHFREE_API_VERSION=2023-08-01

# -------------------------------------------------------------
# 2. Firebase Admin SDK / Cloud Firestore
# -------------------------------------------------------------
# Obtain from Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Note: In .env, replace newlines in the private key with \n
FIREBASE_PRIVATE_KEY=

# Optional: Path to service account JSON file (alternative to FIREBASE_PRIVATE_KEY)
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# -------------------------------------------------------------
# 3. Application & Webhook URL Configuration
# -------------------------------------------------------------
# Public URL of your storefront (used for Cashfree return_url and webhook notify_url)
# Local development: http://localhost:8080 (or ngrok URL for live webhook testing)
# Production: https://velorajewelry.com
APP_URL=http://localhost:8080

# -------------------------------------------------------------
# 4. Optional: Transactional Email Configuration
# -------------------------------------------------------------
# If using SMTP instead of Firebase Trigger Email Extension:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="Velora Concierge <concierge@velorajewelry.com>"
